{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "prisma/seed.ts", "scripts/create-office.ts"],
  "exclude": ["server/**/*.test.ts", "server/tests/**"]
}
