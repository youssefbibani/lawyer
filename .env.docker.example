# Docker Compose settings. Copy to .env.docker and fill in real values (never commit it).

# Database password for the bundled PostgreSQL container (long and random).
POSTGRES_PASSWORD=

# Session signing secret: at least 32 random characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=

# Public HTTPS address of the application, as users type it (behind your reverse proxy).
PUBLIC_URL=https://cabinet.example.tn

# Optional: additional origins allowed to call the API with cookies (comma-separated).
TRUSTED_ORIGINS=

# true when a reverse proxy you control sets X-Forwarded-For (needed for per-client rate limits).
TRUST_PROXY=true

# Optional SMTP for password-reset links and e-mail reminders, e.g. smtps://user:pass@smtp.example.tn:465
# Leave empty: e-mail features then report "not configured" instead of pretending to send.
SMTP_URL=
MAIL_FROM=قصر العدالة <no-reply@example.tn>

# Host port for the application container.
APP_PORT=3001
