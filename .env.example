# Copy to `.env.local` and fill in. Only PUBLIC endpoints go here — never API keys.
# Model and speech credentials must live on the server behind these endpoints.

# Backend implementing POST {URL}/assistant/chat (NDJSON stream of AssistantStreamEvent).
# Leave empty to use the local demo engine (all replies are labelled «تجريبي»).
VITE_ASSISTANT_API_URL=

# Backend endpoint accepting multipart `audio` + `lang` and returning { "text": "..." }.
# Leave empty if no server speech-to-text is available.
VITE_STT_API_URL=

# BCP-47 language for browser speech recognition (Tunisian Arabic where supported).
VITE_SPEECH_LANG=ar-TN

# ——— Smart archive OCR ———
# "local" = Tesseract in the browser (images never leave the device; engine + ara/fra models are
# downloaded on first use), "server" = POST page images to VITE_OCR_API_URL, "none" = disabled
# (extraction fails explicitly instead of producing results).
VITE_OCR_ENGINE=local
# Endpoint for "server": multipart `image` + `langs`, returns { text, confidence, words: [{ text, confidence }] }.
VITE_OCR_API_URL=
# Self-hosted Tesseract language data (e.g. /tessdata) instead of the public CDN.
VITE_OCR_LANG_PATH=

# ═══════════════════════════════════════════════════════════════════════
# Office backend (server/) — read by the API server only, never by the browser bundle.
# For local development copy this file to `.env` and fill in the values. Never commit `.env`.
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001

# PostgreSQL connection (development database). `npm run db:local -- init` prints local URLs.
DATABASE_URL=
# Separate, disposable database for integration and e2e tests (its name must contain "test").
DATABASE_URL_TEST=

# Session signing secret: at least 32 random characters (e.g. `openssl rand -base64 48`).
BETTER_AUTH_SECRET=

# Public address of the application as users open it (the Vite dev server in development).
BETTER_AUTH_URL=http://localhost:8080
# Extra origins allowed to send cookie-authenticated requests (comma-separated, optional).
TRUSTED_ORIGINS=

# Optional SMTP connection string for password-reset links and e-mail reminders.
# Empty = e-mail is reported as "not configured" (development prints reset links to the server log).
SMTP_URL=
MAIL_FROM=

# Chromium used to render PDF receipts: bundled | chrome | msedge | /absolute/path/to/chrome
PDF_BROWSER=chrome

# true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false
# Set to false to disable the reminder delivery worker in this process.
REMINDER_WORKER=true
